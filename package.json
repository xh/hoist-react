{
  "name": "@xh/hoist",
  "version": "88.0.0-SNAPSHOT",
  "description": "Hoist add-on for building and deploying React Applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xh/hoist-react.git"
  },
  "homepage": "https://xh.io",
  "bugs": "https://github.com/xh/hoist-react/issues",
  "author": "Extremely Heavy Industries, Inc.",
  "license": "Apache-2.0",
  "bin": {
    "hoist-mcp": "bin/hoist-mcp.mjs",
    "hoist-docs": "bin/hoist-docs.mjs",
    "hoist-ts": "bin/hoist-ts.mjs"
  },
  "scripts": {
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:code && pnpm lint:mcp && pnpm lint:styles",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"**/*.s?(a|c)ss\"",
    "lint:mcp": "eslint --config mcp/eslint.config.mjs mcp/ bin/hoist-mcp.mjs bin/hoist-docs.mjs bin/hoist-ts.mjs",
    "typecheck": "tsc --noEmit && tsc -p mcp/tsconfig.json",
    "test:mcp": "tsx mcp/data/doc-id-resolver.spec.ts && tsx mcp/data/doc-sections.spec.ts && tsx mcp/data/doc-search.spec.ts && tsx mcp/data/ts-registry.spec.ts && tsx mcp/tools/docs.spec.ts",
    "prepack": "tsc --build",
    "prepare": "husky"
  },
  "sideEffects": [
    "./static/polyfills.js",
    "./desktop/register.ts",
    "./mobile/register.ts",
    "./icon/index.ts",
    "./mobx/index.ts",
    "./kit/blueprint/index.ts",
    "./kit/golden-layout/index.js",
    "./kit/golden-layout/impl/js/**",
    "./core/persist/index.ts",
    "**/*.scss",
    "**/*.css"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "~2.27.0",
    "@azure/msal-browser": "~5.23.0",
    "@azure/msal-common": "~16.14.1",
    "@blueprintjs/core": "^6.20.0",
    "@blueprintjs/datetime": "^6.2.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@daypicker/react": "^10.0.1",
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-pro": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
