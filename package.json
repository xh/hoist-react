    "@modelcontextprotocol/sdk": "^1.30.1",
    "@uiw/codemirror-theme-github": "~4.25.12",
    "classnames": "^2.5.1",
    "commander": "^15.0.0",
    "core-js": "^3.50.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "fast-deep-equal": "^3.1.3",
    "filesize": "~11.0.24",
    "http-status-codes": "^2.3.0",
    "inter-ui": "~4.1.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lodash-inflection": "^1.5.0",
    "minisearch": "^7.2.0",
    "mobx": "~7.0.4",
    "mobx-react-lite": "~5.1.0",
    "moment": "~2.31.0",
    "numbro": "~2.5.0",
    "onsenui": "~2.12.9",
    "qs": "^6.16.0",
    "react-dropzone": "~20.1.2",
    "react-grid-layout": "~2.2.4",
    "react-markdown": "~10.1.0",
    "react-onsenui": "~1.13.3",
    "react-select": "~5.10.2",
    "react-window": "~2.3.3",
    "react-windowed-select": "~5.2.0",
    "remark-breaks": "~4.0.0",
    "remark-gfm": "~4.0.1",
    "router5": "~7.0.2",
    "router5-plugin-browser": "~7.0.2",
    "sass-material-colors": "~0.0.5",
    "semver": "^7.8.5",
    "short-unique-id": "^5.3.2",
    "store2": "^2.14.4",
    "swiper": "~12.2.0",
