{
  "name": "@xh/hoist",
  "version": "92.0.0-SNAPSHOT",
  "description": "Hoist add-on for building and deploying React Applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xh/hoist-react.git"
  },
  "homepage": "https://xh.io",
  "bugs": "https://github.com/xh/hoist-react/issues",
  "author": "Extremely Heavy Industries, Inc.",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:code && pnpm lint:styles",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"**/*.s?(a|c)ss\"",
    "changelog": "xh-changelog",
    "check:vendored": "node scripts/check-vendored.mjs",
    "generate:pdfjs-css": "node scripts/generate-pdfjs-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:report": "vitest run --reporter=default --reporter=./test-support/report/TestReporter.ts",
    "prepack": "tsc --build && hoist-docs-build --root . --file hoist-docs/index.json.gz",
    "prepare": "husky"
  },
  "hoistDocs": {
    "id": "react",
    "index": "hoist-docs/index.json.gz"
  },
  "sideEffects": [
    "./static/polyfills.js",
    "./desktop/register.ts",
    "./mobile/register.ts",
    "./icon/index.ts",
    "./mobx/index.ts",
    "./kit/blueprint/index.ts",
    "./kit/golden-layout/index.js",
    "./kit/golden-layout/impl/js/**",
    "./core/persist/index.ts",
    "**/*.scss",
    "**/*.css"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "~2.30.0",
    "@azure/msal-browser": "~5.29.1",
    "@blueprintjs/core": "^6.23.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@daypicker/react": "^10.0.2",
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/pro-light-svg-icons": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.3.1",
    "@fortawesome/pro-solid-svg-icons": "^7.3.1",
    "@fortawesome/pro-thin-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hello-pangea/dnd": "~18.0.1",
    "@uiw/codemirror-theme-github": "~4.25.12",
    "classnames": "^2.5.1",
    "core-js": "^3.51.0",
    "dompurify": "^3.4.18",
    "fast-deep-equal": "^3.1.3",
    "filesize": "~11.0.35",
    "inflection": "^3.0.2",
    "inter-ui": "~4.1.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "mobx": "~7.1.7",
    "mobx-react-lite": "~5.1.3",
    "moment": "~2.31.0",
    "qs": "^6.17.1",
    "react-dropzone": "~20.2.1",
    "react-grid-layout": "~2.2.4",
    "react-markdown": "~10.1.0",
    "react-select": "~5.10.2",
    "react-window": "~2.5.3",
    "remark-breaks": "~4.0.0",
    "remark-gfm": "~4.0.1",
    "router5": "~8.0.1",
    "router5-plugin-browser": "~8.0.1",
    "sass-material-colors": "~0.0.5",
    "swiper": "~14.4.0",
    "ts-morph": "^28.0.0",
    "unified": "~11.0.5"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1 || ^31.0.0",
    "msw": "^3.0.2",
    "pdfjs-dist": "^6.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.1.1",
    "@xh/eslint-config": "^8.1.0",
    "@xh/hoist-dev-utils": "^16.5.0",
    "@xh/hoist-docs-builder": "^1.0.0",
    "ag-grid-community": "~36.3.0",
    "ag-grid-react": "~36.3.0",
    "csstype": "^3.2.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.7",
    "pdfjs-dist": "~6.5.438",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "type-fest": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
