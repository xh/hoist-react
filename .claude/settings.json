{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "MultiEdit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "Skill(xh:clear-writing)",
      "Skill(xh:hoist-upgrade)",
      "Skill(xh:onboard-app)",
      "Skill(xh:right-size)",
      "Skill(xh:setup-worktree)",
      "Skill(xh:using-hoist-core-reference)",
      "Skill(xh:using-hoist-react-reference)",
      "mcp__hoist-docs__*"
    ]
  },
  "enabledMcpjsonServers": [
    "hoist-docs"
  ],
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "xh@hoist-ai": true
  },
  "extraKnownMarketplaces": {
    "hoist-ai": {
      "source": {
        "source": "github",
        "repo": "xh/hoist-ai"
      },
      "autoUpdate": true
    }
  },
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
